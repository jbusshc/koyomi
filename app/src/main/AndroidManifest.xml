<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Solo lectura: Koyomi no escribe en el calendario, y nada de él sale del teléfono -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Solo para el tiempo, y solo si se elige una ciudad: se envían sus coordenadas a Open-Meteo.
         El código que usa la red (paquete weather) no ve el calendario -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".KoyomiApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.Koyomi">

        <!-- La hora en japonés. Los minutos corren solos; esto solo cambia 午前/午後 y la fecha -->
        <receiver
            android:name=".widget.ClockWidget"
            android:exported="true"
            android:label="@string/widget_clock_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clock_widget_info" />
        </receiver>

        <!-- Todo en uno: enseña más cuanto más grande se hace, y se configura al ponerlo -->
        <receiver
            android:name=".widget.SummaryWidget"
            android:exported="true"
            android:label="@string/widget_summary_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/summary_widget_info" />
        </receiver>

        <!-- El mismo Resumen, ofrecido también en 2×2 y en 4×4 para que el selector lo ponga de su tamaño -->
        <receiver
            android:name=".widget.SummaryCompactWidget"
            android:exported="true"
            android:label="@string/widget_summary_compact_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/summary_compact_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.SummaryLargeWidget"
            android:exported="true"
            android:label="@string/widget_summary_large_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/summary_large_widget_info" />
        </receiver>
        <service
            android:name=".widget.SummaryWidget$CalendarChanged"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service
            android:name=".widget.SummaryWidget$WeatherRefresh"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- La pantalla que se abre al poner un widget, y al volver a configurarlo -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_config_title"
            android:theme="@style/Theme.Koyomi">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
