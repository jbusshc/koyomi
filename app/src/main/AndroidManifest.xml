<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Solo lectura: Koyomi no escribe en el calendario, y nada de él sale del teléfono -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Solo para el tiempo, y solo si se elige una ciudad: se envían sus coordenadas a Open-Meteo.
         El código que usa la red (paquete weather) no ve el calendario -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".KoyomiApp"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:supportsRtl="true"
        android:theme="@style/Theme.Koyomi">

        <!-- La fecha de hoy en la pantalla de inicio. Los dos avisos del sistema son de los pocos que
             todavía llegan a un receptor del manifest: sin ellos, cambiar la hora dejaría la fecha vieja -->
        <receiver
            android:name=".widget.DateWidget"
            android:exported="true"
            android:label="@string/widget_date_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/date_widget_info" />
        </receiver>

        <!-- La fecha y los próximos eventos. Un trabajo del sistema lo repinta cuando el calendario cambia -->
        <receiver
            android:name=".widget.AgendaWidget"
            android:exported="true"
            android:label="@string/widget_agenda_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/agenda_widget_info" />
        </receiver>
        <service
            android:name=".widget.AgendaWidget$CalendarChanged"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- La hora en japonés. Los minutos corren solos; esto solo cambia 午前/午後 y la fecha -->
        <receiver
            android:name=".widget.ClockWidget"
            android:exported="true"
            android:label="@string/widget_clock_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/clock_widget_info" />
        </receiver>

        <!-- El tiempo de la ciudad elegida. Con el widget puesto, un trabajo pide el parte cada pocas horas -->
        <receiver
            android:name=".widget.WeatherWidget"
            android:exported="true"
            android:label="@string/widget_weather_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_widget_info" />
        </receiver>
        <service
            android:name=".widget.WeatherWidget$Refresh"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
