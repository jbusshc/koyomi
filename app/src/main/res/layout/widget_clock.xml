<?xml version="1.0" encoding="utf-8"?>
<!-- El marco y los colores los pone ClockWidget según el tema. La fuente no: un texto vivo de
     widget solo se escribe con las del teléfono (probado: una fuente propia aquí se ignora). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="HardcodedText">

    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="center"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_ampm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:includeFontPadding="false"
                android:text="午後"
                android:textColor="@color/widget_ink_soft"
                android:textSize="15sp" />

            <TextClock
                android:id="@+id/widget_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format12Hour="K時mm分"
                android:format24Hour="H時mm分"
                android:includeFontPadding="false"
                android:textColor="@color/widget_ink"
                android:textSize="32sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_clock_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="令和8年10月4日（日）"
            android:textColor="@color/widget_ink_soft"
            android:textSize="13sp" />

        <!-- La hora de otra ciudad; ClockWidget la enseña solo si se pidió y cabe -->
        <LinearLayout
            android:id="@+id/widget_zone_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:baselineAligned="true"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_zone_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_ink_soft"
                android:textSize="12sp" />

            <TextClock
                android:id="@+id/widget_zone_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:format12Hour="H時mm分"
                android:format24Hour="H時mm分"
                android:includeFontPadding="false"
                android:textColor="@color/widget_ink"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_alarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_ink_soft"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
